{
  "name": "oxlint-plugin-template",
  "version": "0.0.0",
  "private": true,
  "description": "Template for an Oxlint plugin.",
  "keywords": [
    "lint",
    "oxlint",
    "oxlint-plugin"
  ],
  "homepage": "https://github.com/tunderadev/oxlint-plugin-template#readme",
  "bugs": {
    "url": "https://github.com/tunderadev/oxlint-plugin-template/issues"
  },
  "license": "MIT",
  "author": "tunderadev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunderadev/oxlint-plugin-template.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "fix": "vp check --fix",
    "dogfood": "node scripts/dogfood.ts",
    "new-rule": "node scripts/new-rule.ts",
    "init-template": "node scripts/init-template.ts",
    "release": "bumpp",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.83.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.2",
    "bumpp": "^12.3.0",
    "oxlint": "1.83.0",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.14"
  }
}
